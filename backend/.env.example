# Local development can omit DATABASE_URL and uses SQLite in backend/quiz.db.
# For PostgreSQL, uncomment and set a connection string:
# DATABASE_URL=postgresql+psycopg://quiz:quiz@localhost:5432/quiz
FRONTEND_ORIGINS=http://localhost:5173

# Authentication: generate a persistent value with python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
# Keep AUTH_COOKIE_SECURE=true in production; use same-origin or same-site HTTPS domains.
# Mailtrap live sending: verify quizpop.name.ng in Mailtrap before sending.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_FROM=QuizPop <hello@quizpop.name.ng>
SMTP_STARTTLS=true
SMTP_USERNAME=api
# Replace with the live sending API token for the verified domain; never commit it.
SMTP_PASSWORD=<YOUR_API_TOKEN>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback
GOOGLE_LINK_REDIRECT_URL=http://localhost:8000/api/auth/link/google/callback
